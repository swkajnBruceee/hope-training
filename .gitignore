# Local machine paths.
hope_training/whole_body_tracking/setup_train_env.local.sh
*.local.yaml
*.local.yml
*.local.json

# Local-only assets and external reference repos. These are not pinned public
# starter dependencies.
external_repos/
vendor_assets/

hope_ws/src/vrpn_mocap/

# Model artifacts and generated datasets.
data/DATA260703/
*.onnx
*.pt
*.pth
*.ckpt
*.rknn
*.engine
*.trt
*.npz
*.zarr
*.pkl
*.csv
*.tmp
*.log

# Source authoring spreadsheets outside agibot/ are not part of the public starter
# runtime.
*.xlsx

# Agibot-provided A3 materials under agibot/ are tracked as public reference
# assets/examples, including their source tooling and small runtime examples.
!agibot/**/*.csv
!agibot/**/*.xlsx
!agibot/**/*.onnx
!agibot/**/*.rknn
!agibot/**/*.engine
!agibot/**/*.trt
!agibot/**/*.npz
!agibot/**/*.pkl

# Track project datasets under the table-tennis data workspace.
!DATA_PingPang/**/Csv/**/*.csv
!DATA_PingPang/**/CSV/**/*.csv
!data/analysis/mocap_cleaning_outputs/**/*.npz
